{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest)",
      "Bash(python -m pytest *)",
      "Bash(python -m pbi_insights *)",
      "Bash(python -m pbi_insights.cli *)",
      "Bash(python app.py)",
      "Bash(pip install -r *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./uploads/**)"
    ]
  }
}
